{
  "name": "wim-equipment-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contract:java": "tsx scripts/javaContractCheck.ts",
    "ftp:local": "tsx scripts/localFtp.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "basic-ftp": "^5.0.5",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "serialport": "^13.0.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@serialport/binding-mock": "^10.2.2",
    "@types/bunyan": "^1.8.11",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "bunyan": "^1.8.15",
    "concurrently": "^9.2.0",
    "ftp-srv": "^4.6.3",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
